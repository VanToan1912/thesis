{
  "name": "ridewithme",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @ridewithme/db prisma generate",
    "db:migrate": "pnpm --filter @ridewithme/db prisma migrate dev",
    "db:push": "pnpm --filter @ridewithme/db prisma db push",
    "db:seed": "pnpm --filter @ridewithme/db prisma db seed",
    "mobile": "pnpm --filter @ridewithme/mobile dev",
    "admin": "pnpm --filter @ridewithme/admin dev",
    "server": "pnpm --filter @ridewithme/server dev",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down -v"
  }
}
